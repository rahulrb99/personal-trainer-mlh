{
  "$defs": {
    "PlannedExercise": {
      "additionalProperties": false,
      "properties": {
        "exercise_id": {
          "minLength": 1,
          "title": "Exercise Id",
          "type": "string"
        },
        "sets": {
          "maximum": 5,
          "minimum": 1,
          "title": "Sets",
          "type": "integer"
        },
        "reps": {
          "maximum": 30,
          "minimum": 1,
          "title": "Reps",
          "type": "integer"
        },
        "weight_lb": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 5,
              "multipleOf": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Lb"
        }
      },
      "required": [
        "exercise_id",
        "sets",
        "reps"
      ],
      "title": "PlannedExercise",
      "type": "object"
    },
    "Preferences": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "You",
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "mode": {
          "default": "strict",
          "enum": [
            "strict",
            "alternatives"
          ],
          "title": "Mode",
          "type": "string"
        },
        "excluded_exercise_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Excluded Exercise Ids",
          "type": "array"
        },
        "coaching": {
          "default": "standard",
          "enum": [
            "quiet",
            "standard",
            "teach"
          ],
          "title": "Coaching",
          "type": "string"
        }
      },
      "title": "Preferences",
      "type": "object"
    },
    "UserProfile": {
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "title": "User Id",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "preferences": {
          "$ref": "#/$defs/Preferences"
        },
        "muscle_group_ids": {
          "items": {
            "type": "string"
          },
          "title": "Muscle Group Ids",
          "type": "array"
        },
        "plan": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PlannedExercise"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Plan"
        }
      },
      "required": [
        "user_id",
        "email",
        "name",
        "preferences",
        "muscle_group_ids",
        "plan"
      ],
      "title": "UserProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile": {
      "$ref": "#/$defs/UserProfile"
    },
    "access_token": {
      "title": "Access Token",
      "type": "string"
    }
  },
  "required": [
    "profile",
    "access_token"
  ],
  "title": "AuthResult",
  "type": "object"
}
