  "components": {
    "schemas": {
      "Action": {
        "type": "string",
        "enum": [
          "equipment_claimed",
          "equipment_taken",
          "set_completed",
          "skip_exercise",
          "retry_deferred",
          "alternative_accepted",
          "alternative_declined",
          "end_session",
          "weight_updated"
        ],
        "title": "Action"
      },
      "AuthResult": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/UserProfile"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile",
          "access_token"
        ],
        "title": "AuthResult"
      },
      "CreateResult": {
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot",
          "access_token"
        ],
        "title": "CreateResult"
      },
      "CreateSession": {
        "properties": {
          "routine_id": {
            "type": "string",
            "title": "Routine Id",
            "default": "full-body"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          },
          "demo_mode": {
            "type": "boolean",
            "title": "Demo Mode",
            "default": false
          },
          "selected_muscle_group_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Selected Muscle Group Ids"
          },
          "plan": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/PlannedExercise"
                },
                "type": "array",
                "maxItems": 8,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateSession"
      },
      "Event": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "source": {
            "type": "string",
            "enum": [
              "phone",
              "watch",
              "web",
              "voice"
            ],
            "title": "Source"
          },
          "type": {
            "$ref": "#/components/schemas/Action"
          },
          "exercise_instance_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exercise Instance Id"
          },
          "set_index": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Set Index"
          },
          "payload": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "expected_version",
          "source",
          "type"
        ],
        "title": "Event"
      },
      "EventResult": {
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          },
          "replayed": {
            "type": "boolean",
            "title": "Replayed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot",
          "replayed"
        ],
        "title": "EventResult"
      },
      "Exercise": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "equipment": {
            "type": "string",
            "title": "Equipment"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "muscles": {
            "type": "string",
            "title": "Muscles"
          },
          "sets": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Sets"
          },
          "reps": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Reps"
          },
          "rest_seconds": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Rest Seconds"
          },
          "primary_muscle_group": {
            "type": "string",
            "title": "Primary Muscle Group"
          },
          "secondary_muscle_groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Secondary Muscle Groups"
          },
          "weight_min_lb": {
            "type": "integer",
            "minimum": 5.0,
            "title": "Weight Min Lb"
          },
          "weight_max_lb": {
            "type": "integer",
            "minimum": 5.0,
            "title": "Weight Max Lb"
          },
          "weight_step_lb": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Weight Step Lb"
          },
          "setup": {
            "type": "string",
            "title": "Setup"
          },
          "cue": {
            "type": "string",
            "title": "Cue"
          },
          "mistake": {
            "type": "string",
            "title": "Mistake"
          },
          "troubleshooting": {
            "type": "string",
            "title": "Troubleshooting"
          },
          "stop_conditions": {
            "type": "string",
            "title": "Stop Conditions"
          },
          "alternatives": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Alternatives"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/GuidanceSource"
            },
            "type": "array",
            "minItems": 1,
            "title": "Sources"
          },
          "review_status": {
            "type": "string",
            "const": "professional_review_pending",
            "title": "Review Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "equipment",
          "location",
          "muscles",
          "sets",
          "reps",
          "rest_seconds",
          "primary_muscle_group",
          "secondary_muscle_groups",
          "weight_min_lb",
          "weight_max_lb",
          "weight_step_lb",
          "setup",
          "cue",
          "mistake",
          "troubleshooting",
          "stop_conditions",
          "alternatives",
          "sources",
          "review_status"
        ],
        "title": "Exercise"
      },
      "ExerciseInstance": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "equipment": {
            "type": "string",
            "title": "Equipment"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "muscles": {
            "type": "string",
            "title": "Muscles"
          },
          "sets": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Sets"
          },
          "reps": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Reps"
          },
          "rest_seconds": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Rest Seconds"
          },
          "primary_muscle_group": {
            "type": "string",
            "title": "Primary Muscle Group"
          },
          "secondary_muscle_groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Secondary Muscle Groups"
          },
          "weight_min_lb": {
            "type": "integer",
            "minimum": 5.0,
            "title": "Weight Min Lb"
          },
          "weight_max_lb": {
            "type": "integer",
            "minimum": 5.0,
            "title": "Weight Max Lb"
          },
          "weight_step_lb": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Weight Step Lb"
          },
          "setup": {
            "type": "string",
            "title": "Setup"
          },
          "cue": {
            "type": "string",
            "title": "Cue"
          },
          "mistake": {
            "type": "string",
            "title": "Mistake"
          },
          "troubleshooting": {
            "type": "string",
            "title": "Troubleshooting"
          },
          "stop_conditions": {
            "type": "string",
            "title": "Stop Conditions"
          },
          "alternatives": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Alternatives"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/GuidanceSource"
            },
            "type": "array",
            "minItems": 1,
            "title": "Sources"
          },
          "review_status": {
            "type": "string",
            "const": "professional_review_pending",
            "title": "Review Status"
          },
          "instance_id": {
            "type": "string",
            "title": "Instance Id"
          },
          "original_exercise_id": {
            "type": "string",
            "title": "Original Exercise Id"
          },
          "completed_sets": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Completed Sets"
          },
          "weight_lb": {
            "anyOf": [
              {
                "type": "integer",
                "multipleOf": 5.0,
                "maximum": 500.0,
                "minimum": 5.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight Lb"
          },
          "set_records": {
            "items": {
              "$ref": "#/components/schemas/SetRecord"
            },
            "type": "array",
            "title": "Set Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "equipment",
          "location",
          "muscles",
          "sets",
          "reps",
          "rest_seconds",
          "primary_muscle_group",
          "secondary_muscle_groups",
          "weight_min_lb",
          "weight_max_lb",
          "weight_step_lb",
          "setup",
          "cue",
          "mistake",
          "troubleshooting",
          "stop_conditions",
          "alternatives",
          "sources",
          "review_status",
          "instance_id",
          "original_exercise_id",
          "completed_sets"
