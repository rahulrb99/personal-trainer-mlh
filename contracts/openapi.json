            ],
            "title": "Weight Lb"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "exercise_id",
          "sets",
          "reps"
        ],
        "title": "PlannedExercise"
      },
      "Preferences": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name",
            "default": "You"
          },
          "mode": {
            "type": "string",
            "enum": [
              "strict",
              "alternatives"
            ],
            "title": "Mode",
            "default": "strict"
          },
          "excluded_exercise_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Excluded Exercise Ids"
