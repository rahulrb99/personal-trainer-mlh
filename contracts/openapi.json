          },
          "sets": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Sets"
          },
          "reps": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Reps"
          },
          "weight_lb": {
            "anyOf": [
              {
                "type": "integer",
                "multipleOf": 5.0,
                "maximum": 500.0,
                "minimum": 5.0
              },
              {
                "type": "null"
