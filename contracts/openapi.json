          "coaching": {
            "type": "string",
            "enum": [
              "quiet",
              "standard",
              "teach"
            ],
            "title": "Coaching",
            "default": "standard"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Preferences"
      },
      "ProfileUpdate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          },
          "muscle_group_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Muscle Group Ids"
          },
