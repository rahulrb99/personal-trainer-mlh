          "plan"
        ],
        "title": "PlanPreview"
      },
      "PlanRequest": {
        "properties": {
          "muscle_group_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Muscle Group Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "muscle_group_ids"
        ],
