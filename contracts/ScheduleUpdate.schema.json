{
  "$defs": {
    "PlannedExercise": {
      "additionalProperties": false,
      "properties": {
        "exercise_id": {
          "minLength": 1,
          "title": "Exercise Id",
          "type": "string"
        },
        "sets": {
          "maximum": 5,
          "minimum": 1,
          "title": "Sets",
          "type": "integer"
        },
        "reps": {
          "maximum": 30,
          "minimum": 1,
          "title": "Reps",
          "type": "integer"
        },
        "weight_lb": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 5,
              "multipleOf": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Lb"
        }
      },
      "required": [
        "exercise_id",
        "sets",
        "reps"
      ],
      "title": "PlannedExercise",
      "type": "object"
    },
    "WeeklyWorkout": {
      "additionalProperties": false,
      "properties": {
        "weekday": {
          "description": "0 Monday through 6 Sunday, in the user's local calendar",
          "maximum": 6,
          "minimum": 0,
          "title": "Weekday",
          "type": "integer"
        },
        "time": {
          "description": "Local wall time HH:MM; informational, no reminders",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "muscle_group_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Muscle Group Ids",
          "type": "array"
        },
        "plan": {
          "items": {
            "$ref": "#/$defs/PlannedExercise"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Plan",
          "type": "array"
        }
      },
      "required": [
        "weekday",
        "time",
        "muscle_group_ids",
        "plan"
      ],
      "title": "WeeklyWorkout",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schedule": {
      "items": {
        "$ref": "#/$defs/WeeklyWorkout"
      },
      "maxItems": 7,
      "minItems": 1,
      "title": "Schedule",
      "type": "array"
    }
  },
  "required": [
    "schedule"
  ],
  "title": "ScheduleUpdate",
  "type": "object"
}
