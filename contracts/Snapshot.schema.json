{
  "$defs": {
    "Exercise": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "equipment": {
          "title": "Equipment",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "muscles": {
          "title": "Muscles",
          "type": "string"
        },
        "sets": {
          "exclusiveMinimum": 0,
          "title": "Sets",
          "type": "integer"
        },
        "reps": {
          "exclusiveMinimum": 0,
          "title": "Reps",
          "type": "integer"
        },
        "rest_seconds": {
          "exclusiveMinimum": 0,
          "title": "Rest Seconds",
          "type": "integer"
        },
        "primary_muscle_group": {
          "title": "Primary Muscle Group",
          "type": "string"
        },
        "secondary_muscle_groups": {
          "items": {
            "type": "string"
          },
          "title": "Secondary Muscle Groups",
          "type": "array"
        },
        "weight_min_lb": {
          "minimum": 5,
          "title": "Weight Min Lb",
          "type": "integer"
        },
        "weight_max_lb": {
          "minimum": 5,
          "title": "Weight Max Lb",
          "type": "integer"
        },
        "weight_step_lb": {
          "minimum": 1,
          "title": "Weight Step Lb",
          "type": "integer"
        },
        "setup": {
          "title": "Setup",
          "type": "string"
        },
        "cue": {
          "title": "Cue",
          "type": "string"
        },
        "mistake": {
          "title": "Mistake",
          "type": "string"
        },
        "troubleshooting": {
          "title": "Troubleshooting",
          "type": "string"
        },
        "stop_conditions": {
          "title": "Stop Conditions",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/GuidanceSource"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "review_status": {
          "const": "professional_review_pending",
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "equipment",
        "location",
        "muscles",
        "sets",
        "reps",
        "rest_seconds",
        "primary_muscle_group",
        "secondary_muscle_groups",
        "weight_min_lb",
        "weight_max_lb",
        "weight_step_lb",
        "setup",
        "cue",
        "mistake",
        "troubleshooting",
        "stop_conditions",
        "alternatives",
        "sources",
        "review_status"
      ],
      "title": "Exercise",
      "type": "object"
    },
    "ExerciseInstance": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "equipment": {
          "title": "Equipment",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "muscles": {
          "title": "Muscles",
          "type": "string"
        },
        "sets": {
          "exclusiveMinimum": 0,
          "title": "Sets",
          "type": "integer"
        },
        "reps": {
          "exclusiveMinimum": 0,
          "title": "Reps",
          "type": "integer"
        },
        "rest_seconds": {
          "exclusiveMinimum": 0,
          "title": "Rest Seconds",
          "type": "integer"
        },
        "primary_muscle_group": {
          "title": "Primary Muscle Group",
          "type": "string"
        },
        "secondary_muscle_groups": {
          "items": {
            "type": "string"
          },
          "title": "Secondary Muscle Groups",
          "type": "array"
        },
        "weight_min_lb": {
          "minimum": 5,
          "title": "Weight Min Lb",
          "type": "integer"
        },
        "weight_max_lb": {
          "minimum": 5,
          "title": "Weight Max Lb",
          "type": "integer"
        },
        "weight_step_lb": {
          "minimum": 1,
          "title": "Weight Step Lb",
          "type": "integer"
        },
        "setup": {
          "title": "Setup",
          "type": "string"
        },
        "cue": {
          "title": "Cue",
          "type": "string"
        },
        "mistake": {
          "title": "Mistake",
          "type": "string"
        },
        "troubleshooting": {
          "title": "Troubleshooting",
          "type": "string"
        },
        "stop_conditions": {
          "title": "Stop Conditions",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/GuidanceSource"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "review_status": {
          "const": "professional_review_pending",
          "title": "Review Status",
          "type": "string"
        },
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "original_exercise_id": {
          "title": "Original Exercise Id",
          "type": "string"
        },
        "completed_sets": {
          "minimum": 0,
          "title": "Completed Sets",
          "type": "integer"
        },
        "weight_lb": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 5,
              "multipleOf": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Lb"
        },
        "set_records": {
          "items": {
            "$ref": "#/$defs/SetRecord"
          },
          "title": "Set Records",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "equipment",
        "location",
        "muscles",
        "sets",
        "reps",
        "rest_seconds",
        "primary_muscle_group",
        "secondary_muscle_groups",
        "weight_min_lb",
        "weight_max_lb",
        "weight_step_lb",
        "setup",
        "cue",
        "mistake",
        "troubleshooting",
        "stop_conditions",
        "alternatives",
        "sources",
        "review_status",
        "instance_id",
        "original_exercise_id",
        "completed_sets"
      ],
      "title": "ExerciseInstance",
      "type": "object"
    },
    "GuidanceSource": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "GuidanceSource",
      "type": "object"
    },
    "Preferences": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "You",
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "mode": {
          "default": "strict",
          "enum": [
            "strict",
            "alternatives"
          ],
          "title": "Mode",
          "type": "string"
        },
        "excluded_exercise_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Excluded Exercise Ids",
          "type": "array"
        },
        "coaching": {
          "default": "standard",
          "enum": [
            "quiet",
            "standard",
            "teach"
          ],
          "title": "Coaching",
          "type": "string"
        },
        "trainer": {
          "$ref": "#/$defs/TrainerPersona"
        }
      },
      "title": "Preferences",
      "type": "object"
    },
    "SetRecord": {
      "additionalProperties": false,
      "properties": {
        "set_index": {
          "minimum": 1,
          "title": "Set Index",
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Seconds"
        },
        "planned_reps": {
          "exclusiveMinimum": 0,
          "title": "Planned Reps",
          "type": "integer"
        },
        "weight_lb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weight Lb"
        }
      },
      "required": [
        "set_index",
        "started_at",
        "completed_at",
        "duration_seconds",
        "planned_reps",
        "weight_lb"
      ],
      "title": "SetRecord",
      "type": "object"
    },
    "TrainerPersona": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "Mat",
          "maxLength": 30,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "color": {
          "default": "blue",
          "enum": [
            "blue",
            "mint",
            "peach"
          ],
          "title": "Color",
          "type": "string"
        },
        "expression": {
          "default": "happy",
          "enum": [
            "happy",
            "calm",
            "bold"
          ],
          "title": "Expression",
          "type": "string"
        },
        "accessory": {
          "default": "headband",
          "enum": [
            "headband",
            "headphones",
            "none"
          ],
          "title": "Accessory",
          "type": "string"
        },
        "motivation": {
          "default": "",
          "maxLength": 240,
          "title": "Motivation",
          "type": "string"
        },
        "remind": {
          "default": true,
          "title": "Remind",
          "type": "boolean"
        }
      },
      "title": "TrainerPersona",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "server_time": {
      "format": "date-time",
      "title": "Server Time",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ended At"
    },
    "phase": {
      "enum": [
        "awaiting_equipment",
        "awaiting_alternative_confirmation",
        "exercising",
        "resting",
        "blocked",
        "completed",
        "ended"
      ],
      "title": "Phase",
      "type": "string"
    },
    "preferences": {
      "$ref": "#/$defs/Preferences"
    },
    "demo_mode": {
      "title": "Demo Mode",
      "type": "boolean"
    },
    "current": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExerciseInstance"
        },
        {
          "type": "null"
        }
      ]
    },
    "set_index": {
      "minimum": 1,
      "title": "Set Index",
      "type": "integer"
    },
    "rest_deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Rest Deadline"
    },
    "set_started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Set Started At"
    },
    "queue": {
      "items": {
        "$ref": "#/$defs/ExerciseInstance"
      },
      "title": "Queue",
      "type": "array"
    },
    "deferred": {
      "items": {
        "$ref": "#/$defs/ExerciseInstance"
      },
      "title": "Deferred",
      "type": "array"
    },
    "completed": {
      "items": {
        "$ref": "#/$defs/ExerciseInstance"
      },
      "title": "Completed",
      "type": "array"
    },
    "skipped": {
      "items": {
        "$ref": "#/$defs/ExerciseInstance"
      },
      "title": "Skipped",
      "type": "array"
    },
    "pending_alternative": {
      "anyOf": [
        {
          "$ref": "#/$defs/Exercise"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_decision": {
      "title": "Last Decision",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "version",
    "server_time",
    "created_at",
    "ended_at",
    "phase",
    "preferences",
    "demo_mode",
    "current",
    "set_index",
    "rest_deadline",
    "queue",
    "deferred",
    "completed",
    "skipped",
    "pending_alternative",
    "last_decision"
  ],
  "title": "Snapshot",
  "type": "object"
}
