{
  "$defs": {
    "PlannedExercise": {
      "additionalProperties": false,
      "properties": {
        "exercise_id": {
          "minLength": 1,
          "title": "Exercise Id",
          "type": "string"
        },
        "sets": {
          "maximum": 5,
          "minimum": 1,
          "title": "Sets",
          "type": "integer"
        },
        "reps": {
          "maximum": 30,
          "minimum": 1,
          "title": "Reps",
          "type": "integer"
        },
        "weight_lb": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 5,
              "multipleOf": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Lb"
        }
      },
      "required": [
        "exercise_id",
        "sets",
        "reps"
      ],
      "title": "PlannedExercise",
      "type": "object"
    },
    "Preferences": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "You",
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "mode": {
          "default": "strict",
          "enum": [
            "strict",
            "alternatives"
          ],
          "title": "Mode",
          "type": "string"
        },
        "excluded_exercise_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Excluded Exercise Ids",
          "type": "array"
        },
        "coaching": {
          "default": "standard",
          "enum": [
            "quiet",
            "standard",
            "teach"
          ],
          "title": "Coaching",
          "type": "string"
        },
        "trainer": {
          "$ref": "#/$defs/TrainerPersona"
        }
      },
      "title": "Preferences",
      "type": "object"
    },
    "TrainerPersona": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "Mat",
          "maxLength": 30,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "color": {
          "default": "blue",
          "enum": [
            "blue",
            "mint",
            "peach"
          ],
          "title": "Color",
          "type": "string"
        },
        "expression": {
          "default": "happy",
          "enum": [
            "happy",
            "calm",
            "bold"
          ],
          "title": "Expression",
          "type": "string"
        },
        "accessory": {
          "default": "headband",
          "enum": [
            "headband",
            "headphones",
            "none"
          ],
          "title": "Accessory",
          "type": "string"
        },
        "motivation": {
          "default": "",
          "maxLength": 240,
          "title": "Motivation",
          "type": "string"
        },
        "remind": {
          "default": true,
          "title": "Remind",
          "type": "boolean"
        }
      },
      "title": "TrainerPersona",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "routine_id": {
      "default": "full-body",
      "title": "Routine Id",
      "type": "string"
    },
    "preferences": {
      "$ref": "#/$defs/Preferences"
    },
    "demo_mode": {
      "default": false,
      "title": "Demo Mode",
      "type": "boolean"
    },
    "selected_muscle_group_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Selected Muscle Group Ids",
      "type": "array"
    },
    "plan": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/PlannedExercise"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan"
    }
  },
  "title": "CreateSession",
  "type": "object"
}
